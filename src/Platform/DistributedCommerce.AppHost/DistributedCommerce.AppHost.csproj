<Project Sdk="Aspire.AppHost.Sdk/13.6.0">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>distributed-commerce-platform-apphost</UserSecretsId>
    <!-- Keep dotnet run usable without a separate Aspire CLI prerequisite for this portfolio. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Gateway\ApiGateway\ApiGateway.csproj" />
    <ProjectReference Include="..\..\Services\Orders\Orders.Api\Orders.Api.csproj" />
    <ProjectReference Include="..\..\Services\Products\Products.Api\Products.Api.csproj" />
    <ProjectReference Include="..\..\Services\Inventory\Inventory.Service\Inventory.Service.csproj" />
    <ProjectReference Include="..\..\Services\Payments\Payments.Service\Payments.Service.csproj" />
    <ProjectReference Include="..\..\Services\Notifications\Notifications.Service\Notifications.Service.csproj" />
  </ItemGroup>
</Project>
