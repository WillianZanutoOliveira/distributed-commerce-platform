{
  "Keycloak": {
    "Authority": "http://localhost:8180/realms/distributed-commerce",
    "Issuer": "http://localhost:8180/realms/distributed-commerce",
    "Audience": "distributed-commerce-api",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "orders-me-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/me"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "customers-route": {
        "ClusterId": "customers-cluster",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      }
    },
    "Clusters": {
      "orders-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:8081/"
          }
        }
      },
      "customers-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:8085/"
          }
        }
      },
      "products-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:8086/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  }
}
